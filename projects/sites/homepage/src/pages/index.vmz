                        <tr><td><code>.xml</code></td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">declared</td></tr>
                        <tr><td><code>.pdf</code></td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">declared</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="note">A suffix is not a support claim.</p>
        </section>

        <section class="status-band">
            <div>
