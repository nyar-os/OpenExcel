                        <tr><td><code>.csv</code></td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">declared</td></tr>
                        <tr><td><code>.tsv</code></td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">declared</td></tr>
                        <tr><td><code>.ods</code></td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">unsupported</td><td class="state">declared</td></tr>
