{
    "name": "@wae/open-excel",
    "version": "0.0.0",
    "description": "Excel workbook read, inspect, formula and export contracts behind one declared surface",
    "license": "MPL-2.0",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-excel": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/smoke.test.js"
    },
    "keywords": [
        "xlsx",
        "excel",
        "formula",
        "pivot",
        "spreadsheet",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenExcel.git",
        "directory": "projects/packages/open-excel"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@wae/commander": "0.0.7"
    },
    "optionalDependencies": {
        "@wae/open-excel-darwin-arm64": "workspace:*",
        "@wae/open-excel-darwin-x64": "workspace:*",
        "@wae/open-excel-linux-arm64": "workspace:*",
        "@wae/open-excel-linux-x64": "workspace:*",
        "@wae/open-excel-win32-x64": "workspace:*"
    }
}
